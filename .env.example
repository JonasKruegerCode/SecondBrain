# SecondBrain. Copy to .env, configure, then docker compose up -d.
# Docker Engine + Compose v2 are the only host runtime prerequisites.
# Never commit real secrets.

# Loopback host ports. Use different ports for independent installations;
# 0 asks Docker to allocate an unused port (discover with compose port).
WIKI_FRONTEND_PORT=8080
# An explicit WIKI_MCP_PORT wins; otherwise an existing MCP_PORT is retained.
# With neither configured the default is 3001 (older default was 3000).
WIKI_MCP_PORT=

# HTTP MCP only. The browser/API service intentionally does not receive this key.
# Existing MCP_API_KEY is also accepted as a fallback by the MCP service only.
SECOND_BRAIN_WIKI_API_KEY=replace-with-a-long-random-secret

# Defaults accept direct loopback access. Add exact reverse-proxy authorities
# and HTTPS browser origins before exposing MCP through a proxy.
SECOND_BRAIN_WIKI_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
SECOND_BRAIN_WIKI_MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*

# Optional paid read-only chat. Empty keeps chat unavailable without affecting
# page reads, edits, history, lexical search or the Markdown graph.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_PROVIDER=
DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Optional derived indexes. Both server processes receive the same settings.
# Endpoints must be reachable from the containers; localhost refers to each
# container, not to a database on the host. No database is auto-created here.
# Nonempty existing endpoints enable their index unless explicitly disabled (0).
# Use 1 to require a provider, or leave blank for endpoint-based detection.
# Vector rebuilds may call the configured paid embedding provider.
# Blank dimension infers the actual model output; an explicit size is validated.
SECOND_BRAIN_WIKI_GRAPH_INDEX=
SECOND_BRAIN_WIKI_VECTOR_INDEX=
SECOND_BRAIN_WIKI_VECTOR_DIMENSION=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=
LLM_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
# NEO4J_DATABASE, QDRANT_API_KEY, OPENROUTER_EMBEDDING_PROVIDER, GCP_API_KEY
# and GCP_ENDPOINT_URL are also passed through when supplied.


# Optional existing Git wiki: use the same VAULT_GIT_* / VAULT_GITHUB_* values
# as your previous ENV. A configured URL enables startup pull and ongoing sync.
# No URL keeps this instance local. Explicit SECOND_BRAIN_WIKI_GIT_SYNC=0
# disables inherited Git configuration (also enforced by the isolated demo).
VAULT_GIT_URL=
VAULT_GIT_BRANCH=
# Existing vault layout. Set empty for Markdown at repository root.
SECOND_BRAIN_WIKI_GIT_PREFIX=1_knowledge/wiki
VAULT_GIT_PROVIDER=github
VAULT_GIT_AUTH_METHOD=auto
VAULT_GIT_HTTP_USERNAME=
VAULT_GIT_HTTP_ACCESS_TOKEN=
# Legacy VAULT_GITHUB_URL / VAULT_GITHUB_PAT and VAULT_GIT_HTTP_TOKEN also work.
# SSH: existing key path (mount read-only) or inline VAULT_GIT_SSH_KEY.
# A configured known-hosts path must also be mounted read-only; host checks
# stay strict. Secrets are supplied to Git transiently, never in remote URLs.

# Optional immutable image selections; leave blank for published latest.
# Select matching backend/MCP/frontend versions for a controlled update.
WIKI_BACKEND_IMAGE=
WIKI_MCP_IMAGE=
WIKI_FRONTEND_IMAGE=
