# Managed Wiki 2.0 preview. Copy to .env.wiki; never commit real secrets.

# Loopback host ports. Use different ports for independent installations;
# 0 asks Docker to allocate an unused port (discover with compose port).
WIKI_FRONTEND_PORT=8080
WIKI_MCP_PORT=3001

# HTTP MCP only. The browser/API service intentionally does not receive this key.
SECOND_BRAIN_WIKI_API_KEY=replace-with-a-long-random-secret

# Defaults accept direct loopback access. Add exact reverse-proxy authorities
# and HTTPS browser origins before exposing MCP through a proxy.
SECOND_BRAIN_WIKI_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
SECOND_BRAIN_WIKI_MCP_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*

# Optional paid read-only chat. Empty keeps chat unavailable without affecting
# page reads, edits, history, lexical search or the Markdown graph.
OPENROUTER_API_KEY=
DEFAULT_MODEL=deepseek/deepseek-v4-flash


# Optional existing Git wiki: use the same VAULT_GIT_* / VAULT_GITHUB_* values
# as your previous ENV. A configured URL enables startup pull and ongoing sync.
# No URL keeps this instance local. Explicit SECOND_BRAIN_WIKI_GIT_SYNC=0
# disables inherited Git configuration (also enforced by the isolated demo).
VAULT_GIT_URL=
VAULT_GIT_BRANCH=
VAULT_GIT_PROVIDER=github
VAULT_GIT_AUTH_METHOD=auto
VAULT_GIT_HTTP_USERNAME=
VAULT_GIT_HTTP_ACCESS_TOKEN=
# Legacy VAULT_GITHUB_URL / VAULT_GITHUB_PAT and VAULT_GIT_HTTP_TOKEN also work.
# SSH: existing key path (mount read-only) or inline VAULT_GIT_SSH_KEY.
# A configured known-hosts path must also be mounted read-only; host checks
# stay strict. Secrets are supplied to Git transiently, never in remote URLs.
